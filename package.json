{
  "name": "rrze-settings",
  "title": "RRZE Settings",
  "version": "2.2.9",
  "description": "General settings and enhancements for a WordPress multisite installation.",
  "main": "rrze-settings.php",
  "textdomain": "rrze-settings",
  "textDomain": "rrze-settings",
  "private": true,
  "engines": {
    "node": ">=22.8.0",
    "npm": ">=10.8.2"
  },
  "browserslist": [
    "extends @wordpress/browserslist-config"
  ],
  "scripts": {
    "readme": "node scripts/build-readme.js",
    "version:dev": "node scripts/build-version.js dev",
    "version:prod": "node scripts/build-version.js prod",
    "version:release": "node scripts/build-version.js release",
    "build:js": "wp-scripts build",
    "build:css": "node scripts/build-sass.js prod",
    "build:css:dev": "node scripts/build-sass.js dev",
    "watch:js": "wp-scripts start",
    "watch:css": "node scripts/build-sass.js dev --watch",
    "build:assets": "npm run build:js && npm run build:css",
    "start": "npm run build:css:dev && wp-scripts start",
    "watch": "npm run watch:js & npm run watch:css",
    "dev": "npm run build:assets && npm run version:dev && npm run readme",
    "build": "npm run build:assets && npm run version:prod && npm run readme",
    "prod": "npm run build",
    "release": "npm run build:assets && npm run version:release && npm run readme",
    "format": "wp-scripts format src",
    "lint:js": "wp-scripts lint-js src",
    "check-engines": "wp-scripts check-engines",
    "check-licenses": "wp-scripts check-licenses --prod --gpl3",
    "packages-update": "wp-scripts packages-update",
    "make-pot": "wp i18n make-pot ./ languages/rrze-settings.pot --domain=rrze-settings --exclude=vendor,node_modules,_tmp",
    "make-php": "wp i18n make-php languages"
  },
  "compatibility": {
    "wprequires": "6.9",
    "wptestedup": "7.0",
    "phprequires": "8.2"
  },
  "supports": {
    "email": "webmaster@fau.de"
  },
  "author": {
    "name": "RRZE Webteam",
    "url": "https://www.wp.rrze.fau.de"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/RRZE-Webteam/rrze-settings",
    "issues": "https://github.com/RRZE-Webteam/rrze-settings/issues"
  },
  "license": "GNU General Public License Version 3",
  "licenseurl": "https://www.gnu.org/licenses/gpl-3.0.html",
  "tags": "Plugin, WordPress, Multisite, RRZE, FAU, Settings",
  "dependencies": {
    "@wordpress/block-library": "latest",
    "@wordpress/blocks": "latest",
    "@wordpress/data": "^10.44.0",
    "@wordpress/dom-ready": "^4.44.0",
    "@wordpress/edit-post": "latest",
    "@wordpress/element": "latest",
    "@wordpress/hooks": "latest",
    "@wordpress/i18n": "latest",
    "@wordpress/preferences": "^4.44.0"
  },
  "devDependencies": {
    "axios": "^1.15.0",
    "classnames": "^2.5.1",
    "rtlcss": "^4.3.0",
    "sass": "^1.97.3",
    "@wordpress/scripts": "32.0.0",
    "@types/wordpress__dom-ready": "^2.9.0",
    "@types/wordpress__block-editor": "^15.0.6"
  }
}
