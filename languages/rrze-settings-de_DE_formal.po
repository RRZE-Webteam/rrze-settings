#: includes/Heartbeat/Settings.php:35
#: includes/Heartbeat/Settings.php:127
msgid "Heartbeat"
msgstr "Heartbeat"

#: includes/Heartbeat/Settings.php:134
msgid "Disable Heartbeat On Frontend"
msgstr "Heartbeat im Frontend deaktivieren"

#: includes/Heartbeat/Settings.php:140
msgid "Disable Heartbeat on the frontend for non-logged-in users (e.g., visitors)."
msgstr "Deaktiviere Heartbeat im Frontend für nicht eingeloggte Nutzer (z. B. Besucher)."

#: includes/Heartbeat/Settings.php:146
msgid "Disable Heartbeat In Admin Area"
msgstr "Heartbeat im Admin-Bereich deaktivieren"

#: includes/Heartbeat/Settings.php:152
msgid "Disable Heartbeat in the admin area (except on post editor screens)."
msgstr "Deaktiviere Heartbeat im Admin-Bereich (außer auf Posts-Editor-Screens)."

#: includes/Heartbeat/Settings.php:158
msgid "Force JS interval To Slow"
msgstr "Erzwinge langsames JS-Intervall"

#: includes/Heartbeat/Settings.php:164
msgid "Set the JavaScript interval to “slow” (about 60s) in the admin area as a fallback if other settings do not apply."
msgstr "Setze das JavaScript-Intervall im Admin-Bereich auf „slow“ (ca. 60 s) als Fallback, falls andere Einstellungen nicht greifen."

#: includes/Heartbeat/Settings.php:170
msgid "Editor interval"
msgstr "Editor-Intervall"

#: includes/Heartbeat/Settings.php:178
#: includes/Heartbeat/Settings.php:193
#: includes/Writing/Settings.php:236
msgid "seconds"
msgstr "Sekunden"

#: includes/Heartbeat/Settings.php:179
msgid "Interval for post editors (seconds)."
msgstr "Intervall für Posts-Editoren (Sekunden)."

#: includes/Heartbeat/Settings.php:185
msgid "Admin Interval"
msgstr "Admin-Intervall"

#: includes/Heartbeat/Settings.php:194
msgid "Interval for other admin pages (seconds)."
msgstr "Intervall für andere Admin-Seiten (Sekunden)."

#: includes/Heartbeat/Settings.php:200
msgid "Role Overrides"
msgstr "Rollen-Überschreibungen"

#: includes/Heartbeat/Settings.php:207
msgid "Set custom Heartbeat intervals per role. Provide a JSON object where each role key contains two values: editor for post editor screens and default for other admin pages. Intervals are in seconds. Example: {\"administrator\":{\"editor\":15,\"default\":60},\"editor\":{\"editor\":30,\"default\":90},\"author\":{\"editor\":45,\"default\":120}}."
msgstr "Benutzerdefinierte Heartbeat-Intervalle pro Rolle festlegen. Es ist ein JSON-Objekt anzugeben, bei dem jeder Rollenschlüssel zwei Werte enthält: „editor“ für Beitragseditor-Seiten und „default“ für andere Admin-Seiten. Die Intervalle werden in Sekunden angegeben. Beispiel: {\"administrator\":{\"editor\":15,\"default\":60},\"editor\":{\"editor\":30,\"default\":90},\"author\":{\"editor\":45,\"default\":120}}."

#: includes/Heartbeat/Settings.php:213
msgid "Allowed Admin Page Hooks"
msgstr "Erlaubte Admin-Seiten-Hooks"

#: includes/Heartbeat/Settings.php:220
msgid "List of admin page hooks where Heartbeat is always allowed (one per line). Post editors (post.php, post-new.php) and the Site Editor are always allowed."
msgstr "Liste der Admin-Seiten-Hooks, auf denen Heartbeat immer erlaubt ist (ein Eintrag pro Zeile). Beitrags-Editoren (post.php, post-new.php) und der Site-Editor sind immer erlaubt."

#: includes/Heartbeat/Settings.php:232
msgid "This page enables network administrators to manage heartbeat-related settings across the multisite network."
msgstr "Auf dieser Seite können Netzwerk-Administratoren die Heartbeat-bezogenen Einstellungen im gesamten Multisite-Netzwerk verwalten."

